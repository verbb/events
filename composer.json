{
    "name": "verbb/events",
    "description": "A Craft CMS plugin for event management, Craft Commerce ticketing, capacity and check-in.",
    "type": "craft-plugin",
    "version": "3.1.17",
    "keywords": [
        "craft",
        "cms",
        "craftcms",
        "craft-plugin",
        "events"
    ],
    "support": {
        "email": "support@verbb.io",
        "issues": "https://github.com/verbb/events/issues?state=open",
        "source": "https://github.com/verbb/events",
        "docs": "https://github.com/verbb/events",
        "rss": "https://github.com/verbb/events/commits/v2.atom"
    },
    "license": "proprietary",
    "authors": [
        {
            "name": "Verbb",
            "homepage": "https://verbb.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.10.0",
        "craftcms/commerce": "^5.0.0",
        "dompdf/dompdf": "^2.0.4 || ^3.0",
        "endroid/qr-code": "^5.1.0",
        "jsvrcek/ics": "^0.8.0",
        "verbb/base": "^3.0.20"
    },
    "autoload": {
        "psr-4": {
            "verbb\\events\\": "src/"
        }
    },
    "extra": {
        "name": "Events",
        "handle": "events",
        "changelogUrl": "https://raw.githubusercontent.com/verbb/events/craft-5/CHANGELOG.md",
        "class": "verbb\\events\\Events"
    },
    "scripts": {
        "test:class-resolution-regressions": "@php tests/regression/class-resolution.php",
        "test:nested-event-criteria": "@php tests/regression/nested-event-criteria.php",
        "test:occurrence-range": "@php tests/regression/occurrence-range.php",
        "test:graphql-ticket-type-owners": "@php tests/regression/graphql-ticket-type-owners.php",
        "test:ticket-availability": "@php tests/regression/ticket-availability.php",
        "test:ticket-type-order": "@php tests/regression/ticket-type-order.php"
    }
}
